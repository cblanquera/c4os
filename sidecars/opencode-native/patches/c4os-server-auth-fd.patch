@@ -1,4 +1,45 @@
 import { Config } from "effect"
+import { closeSync, readFileSync } from "node:fs"
+
+const C4OS_SERVER_SECRET_FD_ENV = "C4OS_OPENCODE_SERVER_SECRET_FD"
+const C4OS_MIN_SECRET_FD = 64
+const C4OS_MAX_SECRET_FD = 1023
+const C4OS_MIN_SERVER_SECRET_BYTES = 32
+const C4OS_MAX_SERVER_SECRET_BYTES = 64 * 1024
+
+function serverPassword() {
+  const descriptorText = process.env[C4OS_SERVER_SECRET_FD_ENV]
+  if (descriptorText === undefined) return process.env["OPENCODE_SERVER_PASSWORD"]
+  if (process.env["OPENCODE_SERVER_PASSWORD"] !== undefined || !/^[0-9]+$/.test(descriptorText)) {
+    throw new Error("invalid C4OS OpenCode server credential channel")
+  }
+  const descriptor = Number(descriptorText)
+  if (
+    !Number.isSafeInteger(descriptor) ||
+    descriptor < C4OS_MIN_SECRET_FD ||
+    descriptor > C4OS_MAX_SECRET_FD ||
+    String(descriptor) !== descriptorText
+  ) {
+    throw new Error("invalid C4OS OpenCode server credential descriptor")
+  }
+
+  let secret: Buffer<ArrayBufferLike> | undefined
+  try {
+    secret = readFileSync(descriptor)
+    if (
+      secret.length < C4OS_MIN_SERVER_SECRET_BYTES ||
+      secret.length > C4OS_MAX_SERVER_SECRET_BYTES ||
+      secret.some((byte) => byte < 0x20 || byte > 0x7e)
+    ) {
+      throw new Error("invalid C4OS OpenCode server credential")
+    }
+    return secret.toString("utf8")
+  } finally {
+    delete process.env[C4OS_SERVER_SECRET_FD_ENV]
+    secret?.fill(0)
+    closeSync(descriptor)
+  }
+}
 
