{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "C4OS",
  "version": "0.1.0",
  "identifier": "com.c4os.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "C4OS",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["app"]
  }
}
